{
  "name": "agent-plugin-ci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "cli": "pnpm --filter @agent-plugin-ci/cli start",
    "pack:cli": "pnpm --filter @agent-plugin-ci/cli pack --pack-destination artifacts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
